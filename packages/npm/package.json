{
  "name": "goodvibes-cli",
  "version": "1.11.0",
  "description": "One-command bootstrap for vibe coding projects",
  "type": "module",
  "bin": {
    "goodvibes": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "templates",
    "hooks",
    "LICENSE",
    "NOTICE"
  ],
  "homepage": "https://github.com/jgiox/goodvibes",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgiox/goodvibes"
  },
  "keywords": [
    "scaffold",
    "vibe-coding",
    "claude",
    "llm",
    "starter-kit",
    "cli",
    "ai-coding",
    "claude-code",
    "copilot"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "scripts": {
    "prebuild": "node -e \"const{cpSync,rmSync}=require('fs');rmSync('./templates',{recursive:true,force:true});cpSync('../../templates','./templates',{recursive:true,force:true});rmSync('./hooks',{recursive:true,force:true});cpSync('../../hooks','./hooks',{recursive:true,force:true});cpSync('../../LICENSE','./LICENSE');cpSync('../../NOTICE','./NOTICE')\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^15",
    "@clack/prompts": "^1",
    "fs-extra": "^11",
    "execa": "^10"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^7",
    "@types/node": "^26",
    "@types/fs-extra": "^11.0.4",
    "vitest": "^5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.18"
  }
}
